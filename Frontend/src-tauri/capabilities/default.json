{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "IPC for the splash page and the app pages served by the local Go backend. Only 127.0.0.1 origins get access, and the backend itself rejects any request without the per-launch desktop token.",
  "windows": ["main", "floating", "checkin"],
  "local": true,
  "remote": {
    "urls": ["http://127.0.0.1:*/*", "http://127.0.0.1:*"]
  },
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:window:allow-minimize",
    "core:window:allow-hide",
    "core:window:allow-show",
    "core:window:allow-set-focus",
    "core:window:allow-close",
    "core:window:allow-toggle-maximize",
    "core:window:allow-internal-toggle-maximize",
    "allow-get-preferences",
    "allow-set-preferences",
    "allow-get-shortcut-issues",
    "allow-set-floating-compact",
    "allow-export-preferences",
    "allow-import-preferences",
    "allow-has-database-url",
    "allow-save-database-url",
    "allow-forget-database-url",
    "allow-backend-status",
    "allow-restart-backend",
    "allow-update-tray",
    "allow-show-floating",
    "allow-hide-floating",
    "allow-toggle-floating",
    "allow-is-floating-visible",
    "allow-minimize-floating",
    "allow-show-dashboard",
    "allow-timer-action-via-main",
    "allow-show-checkin",
    "allow-hide-checkin",
    "allow-schedule-checkin",
    "allow-cancel-checkin",
    "allow-get-checkin",
    "allow-checkin-response",
    "allow-notify",
    "allow-get-autostart",
    "allow-set-autostart",
    "allow-app-info",
    "allow-check-update",
    "allow-install-update",
    "allow-quit-app"
  ]
}
