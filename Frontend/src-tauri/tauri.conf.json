{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Notch Buddy",
  "version": "1.0.0",
  "identifier": "app.notchbuddy.desktop",
  "build": {
    "frontendDist": "splash",
    "beforeDevCommand": "npm run desktop:prepare",
    "beforeBuildCommand": "npm run desktop:prepare"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "Notch Buddy",
    "category": "Productivity",
    "shortDescription": "Tasks, notes and a global focus timer",
    "longDescription": "Notch Buddy runs entirely on your computer with your own PostgreSQL database. The focus timer keeps running from the tray and an always-on-top floating window.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/productivity-backend"],
    "resources": {
      "../dist/": "frontend/"
    },
    "createUpdaterArtifacts": false,
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" },
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "REPLACE_WITH_YOUR_TAURI_SIGNER_PUBLIC_KEY",
      "endpoints": [
        "https://github.com/OWNER/REPO/releases/latest/download/latest.json"
      ],
      "windows": { "installMode": "passive" }
    }
  }
}
